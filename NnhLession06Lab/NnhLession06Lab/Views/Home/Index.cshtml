@{
    ViewData["Title"] = "Trang chủ ";
}

<div class="main-container">

    <!-- HEADER -->
    <header>

        <div class="logo">
            DEMO LAB
        </div>

        <nav>
            <a href="/">Trang chủ</a>
            <a href="#">Giới thiệu</a>
            <a href="#">Liên hệ</a>
            <a href="#">Sản phẩm</a>
        </nav>

    </header>


    <!-- NỘI DUNG -->
    <div class="content">

        <!-- CỘT TRÁI -->
        <aside>

            <!-- Partial View -->
            <partial name="_Category" />

            <!-- Banner -->
            <div class="banner">

                <img src="/images/banner.jpg"
                     alt="Banner" />

            </div>

        </aside>


        <!-- CỘT PHẢI -->
        <main>

            <!-- Load từ Action của HomeController -->
            <div id="new-products">

                @await Html.PartialAsync(
                    "_NewProducts",
                    new List<NnhLession04.Models.NnhProduct>()
                )

            </div>


            <!-- Load từ ViewComponent -->
            <div>
                @await Component.InvokeAsync("HotProduct")
            </div>

        </main>

    </div>


    <!-- FOOTER -->
    <footer>

        <div class="footer-item">

            <h3>GIỚI THIỆU</h3>

            <p>
                Lorem ipsum dolor sit amet consectetur adipisicing elit.
                Debitis ab suscipit deserunt mollitia reiciendis,
                nobis iure aliquam velit laboriosam ducimus veritatis corporis est.
            </p>

        </div>

        <div class="footer-item">

            <h3>LIÊN HỆ</h3>

            <p>
                Lorem ipsum dolor sit amet consectetur adipisicing elit.
                Odio amet suscipit quasi quisquam impedit magni molestias.
            </p>

        </div>

    </footer>

</div>