@{
    ViewData["Title"] = "Danh sách tài khoản";
    var accounts = ViewBag.NnhAccounts as List<NnhLession04.Models.NnhAccount>;
}

<div class="row">

    @foreach (var item in accounts)
    {
        <div class="col-md-4 my-3">
            <div class="card">

                <div class="card-body">

                    <div class="img-fluid">
                        <img src="@item.Avatar"
                             alt="@item.Name"
                             style="width: 100%; height: 250px; object-fit: cover;" />
                    </div>

                    <div class="mt-3">
                        <h3>@item.Name</h3>

                        <p>@item.Bio</p>

                        <a asp-route="NnhProfile"
                           asp-route-id="@item.Id"
                           class="btn btn-success">
                            Profile

                        </a>
                    </div>

                </div>

            </div>
        </div>
    }

</div>