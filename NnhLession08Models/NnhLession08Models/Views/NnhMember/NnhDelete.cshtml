@model NnhLession08Models.Models.NnhMember

@{
    ViewData["Title"] = "Xóa thành viên ";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>NnhLession08Models.Models.NnhMember</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhUserName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhUserName)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhPassword)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhPassword)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhEmail)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhEmail)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhFullname)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhFullname)
        </dd>
    </dl>

    <form asp-action="NnhDeleted" method="post">
        <input name="id" value="@Model.NnhMemberId" type="hidden">
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>