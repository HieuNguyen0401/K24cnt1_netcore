@model NnhLession08Models.Models.NnhMember

@{
    ViewData["Title"] = "Thông tin chi tiết thành viên ";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>NnhMember</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhUserName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhUserName)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhPassword)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhPassword)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhEmail)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhEmail)
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NnhFullname)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NnhFullname)
        </dd>
    </dl>
</div>

<div>
    @Html.ActionLink("Sửa ", "NnhEdit", new { id = Model.NnhMemberId }) |
    @Html.ActionLink("Quay lại ", "Index")
</div>