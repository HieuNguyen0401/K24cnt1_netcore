@model IEnumerable<NnhLession08Models.Models.NnhMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="NnhCreate" class="btn btn-primary">THÊM MỚI</a>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NnhMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NnhUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NnhPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NnhEmail)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NnhFullname)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.NnhMemberId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NnhUserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NnhPassword)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NnhEmail)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NnhFullname)
                    </td>
                    <td>
                        @Html.ActionLink("Sửa", "NnhEdit", new { id = item.NnhMemberId }) |
                        @Html.ActionLink("Chi tiết", "NnhDetails", new { id = item.NnhMemberId }) |
                        @Html.ActionLink("Xóa", "NnhDelete", new { id = item.NnhMemberId })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>