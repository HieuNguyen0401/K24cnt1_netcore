@model NnhLession07Models.Models.DataModels.NnhMember

@{
    ViewData["Title"] = "Create";
}


<div class="card p-3">
    <h1>Create</h1>

    <h4>NnhMember</h4>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" method ="post" asp-controller="NnhMember">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="NnhMemberId" class="control-label"></label>
                    <input asp-for="NnhMemberId" class="form-control" />
                    <span asp-validation-for="NnhMemberId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnhUserName" class="control-label"></label>
                    <input asp-for="NnhUserName" class="form-control" />
                    <span asp-validation-for="NnhUserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnhPassword" class="control-label"></label>
                    <input asp-for="NnhPassword" class="form-control" />
                    <span asp-validation-for="NnhPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnhFullname" class="control-label"></label>
                    <input asp-for="NnhFullname" class="form-control" />
                    <span asp-validation-for="NnhFullname" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NnhEmail" class="control-label"></label>
                    <input asp-for="NnhEmail" class="form-control" />
                    <span asp-validation-for="NnhEmail" class="text-danger"></span>
                </div>
                <div class="form-group my-2">
                    <input type="submit" value="Ghi lại" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</div>
