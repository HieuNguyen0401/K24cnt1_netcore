@model List<NnhLession03.Models.NnhProduct>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var products = ViewData["Products"] as List<NnhLession03.Models.NnhProduct>;
    int stt = 0;
}

<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (NnhProduct item in Model)
                {
                    stt++;
                    <tr>
                        <td>@stt</td>
                        <td>@item.NnhProductId</td>
                        <td>@item.NnhProductName</td>
                        <td>@item.NnhYearRelease</td>
                        <td>@item.NnhPrice</td>
                        <td>
                            <a href="#">Xem</a>
                            <a href="#">Sửa</a>
                            <a href="#">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <th colspan="6">
                        Tổng số sản phẩm: @Model.Count
                    </th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>