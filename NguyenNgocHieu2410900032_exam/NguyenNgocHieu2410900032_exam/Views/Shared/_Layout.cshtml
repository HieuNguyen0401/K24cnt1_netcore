                    <h5>Thông tin sinh viên</h5>

                    <p>
                        <strong>Họ và tên:</strong>
                        Nguyễn Ngọc Hiếu
                    </p>

                    <p>
                        <strong>Mã sinh viên:</strong>
                        2410900032
                    </p>

                    <p>
                        <strong>Lớp:</strong>
                        K24CNT1
                    </p>

                </div>


                <!-- THONG TIN LIEN HE -->
                <div class="footer-column">

                    <h5>Thông tin liên hệ</h5>

                    <p>
                        <strong>Email:</strong>
                        nguyengocHieu@gmail.com
                    </p>

                    <p>
                        <strong>Điện thoại:</strong>
                        0978654321
                    </p>

                    <p>
                        <strong>Địa chỉ:</strong>
                        Hà Nội, Việt Nam
