
@model IEnumerable<NguyenNgocHieu2410900032_exam.Models.NnhStudent>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container-fluid py-4">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                Danh sách sinh viên
            </h2>
            <p class="text-muted mb-0">
                Quản lý thông tin sinh viên
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Thêm sinh viên
        </a>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                Danh sách sinh viên
            </h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.NnhName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NnhGender)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NnhBirthDay)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NnhEmail)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NnhPhone)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.NnhActive)
                            </th>

                            <th class="text-center">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @Html.DisplayFor(model => item.NnhName)
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @Html.DisplayFor(model => item.NnhGender)
                                    </span>
                                </td>

                                <td>
                                    @Html.DisplayFor(model => item.NnhBirthDay)
                                </td>

                                <td>
                                    <span class="text-primary">
                                        @Html.DisplayFor(model => item.NnhEmail)
                                    </span>
                                </td>

                                <td>
                                    @Html.DisplayFor(model => item.NnhPhone)
                                </td>

                                <td>
                                    @if (item.NnhActive)
                                    {
                                        <span class="badge bg-success">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Không hoạt động
                                        </span>
                                    }
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning me-1">
                                        Sửa
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info text-white me-1">
                                        Xem
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">
                                        Xóa
                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

        <div class="card-footer text-muted">
            Tổng số sinh viên:
            <strong>@Model.Count()</strong>
        </div>

    </div>

</div>

